{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    "security:gomodIndirectSecurityUpdates",
    ":automergePr",
    ":configMigration",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "timezone": "Australia/Melbourne",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "commitMessageExtra": "({{manager}})",
    "additionalBranchPrefix": "{{manager}}-"
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**"
  ],
  "gitIgnoredAuthors": ["225126206+woodmin[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process annotated dependencies",
      "managerFilePatterns": ["/.*/"],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{/if}}"
    },
    {
      "description": "Update shared action pins (per-action prefixed tags)",
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: woodleighschool/\\.github/actions/(?<action>[\\w-]+)@(?<currentDigest>[a-f0-9]{40})\\s+#\\s+[\\w-]+-(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "woodleighschool/.github/actions/{{{action}}}",
      "packageNameTemplate": "woodleighschool/.github",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^{{{action}}}-(?<version>v?\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "commitMessageExtra": "({{currentVersion}} → {{newVersion}})"
    },
    {
      "matchUpdateTypes": ["digest"],
      "commitMessageExtra": "({{currentDigestShort}} → {{newDigestShort}})"
    },
    {
      "matchDatasources": ["docker"],
      "semanticCommitScope": "container",
      "commitMessageTopic": "image {{depName}}"
    },
    {
      "matchManagers": ["gomod"],
      "semanticCommitScope": "go",
      "commitMessageTopic": "module {{depName}}"
    },
    {
      "matchManagers": ["cargo"],
      "semanticCommitScope": "rust",
      "commitMessageTopic": "crate {{depName}}"
    },
    {
      "matchManagers": ["npm"],
      "semanticCommitScope": "npm",
      "commitMessageTopic": "dependency {{depName}}"
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "action {{depName}}"
    },
    {
      "matchDatasources": ["github-releases"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "github-release",
      "commitMessageTopic": "release {{depName}}"
    },
    {
      "matchManagers": ["mise"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "mise",
      "commitMessageTopic": "tool {{depName}}"
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["type/major"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "labels": ["type/minor"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "labels": ["type/major"],
      "additionalBranchPrefix": "major-"
    },
    {
      "matchUpdateTypes": ["patch"],
      "labels": ["type/patch"]
    },
    {
      "matchUpdateTypes": ["digest"],
      "labels": ["type/digest"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "groupSlug": "mise-tools",
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["go"],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["rust"],
      "matchFileNames": [".mise/config.toml"],
      "groupName": "Rust toolchain",
      "groupSlug": "rust-toolchain"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["node"],
      "matchFileNames": [".mise/config.toml"],
      "groupName": "Node toolchain",
      "groupSlug": "node-toolchain"
    },
    {
      "matchManagers": ["mise", "npm"],
      "matchDepNames": ["pnpm"],
      "matchDepTypes": ["tools", "packageManager"],
      "matchFileNames": [".mise/config.toml", "**/package.json"],
      "groupName": "pnpm",
      "groupSlug": "pnpm",
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-dom"],
      "matchFileNames": ["**/package.json"],
      "groupName": "React runtime",
      "groupSlug": "react-runtime"
    },
    {
      "description": "Leave prefixed action pins to the shared action manager",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["woodleighschool/.github"],
      "matchDepTypes": ["action"],
      "matchFileNames": [".github/workflows/*.yaml", ".github/workflows/*.yml"],
      "matchCurrentValue": "/^[\\w-]+-v?\\d+\\.\\d+\\.\\d+$/",
      "matchJsonata": ["$exists(currentDigest)"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["woodleighschool/.github/actions/*"],
      "groupName": "github-actions",
      "minimumReleaseAge": "0 days",
      "semanticCommitType": "chore",
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "action {{depName}}",
      "commitMessagePrefix": "{{semanticCommitType}}({{semanticCommitScope}}):"
    },
    {
      "matchCategories": ["golang", "js", "python", "rust"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchSourceUrls": ["https://github.com/woodleighschool/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "matchSourceUrls": ["https://github.com/aws/aws-sdk-go-v2{/**,}"],
      "fetchChangeLogs": "off"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Excluded devtools still automerge; a bad bump only fails CI.",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "matchDepNames": [
        "!aqua:dadav/helm-schema",
        "!helm-unittest/helm-unittest",
        "!oxfmt",
        "!shellcheck"
      ],
      "automerge": false
    }
  ]
}
